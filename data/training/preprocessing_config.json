    "layer_count",
    "curing_temperature_c",
    "fiber_volume_fraction",
    "void_content_pct"
  ],
  "encoder": "OneHotEncoder(handle_unknown=\"ignore\")",
  "scaler": "StandardScaler for numerical features",
  "missing_value_policy": {
    "current_missing_values": {
