{
  "project_stage": "Step 2 - Data Cleaning and Preprocessing",
  "source_dataset": "data/training/composite_strength_training.csv",
  "target": "tensile_strength_mpa",
  "categorical_features": [
    "fiber_type",
    "resin_type"
  ],
  "numerical_features": [
