      "resin_type": 0,
      "density_g_cm3": 0,
      "layer_count": 0,
      "curing_temperature_c": 0,
      "fiber_volume_fraction": 0,
      "void_content_pct": 0,
      "tensile_strength_mpa": 0
    },
    "pipeline_numeric_strategy": "median",
    "pipeline_categorical_strategy": "most_frequent"
  },
  "outlier_policy": {
    "target_iqr_outliers": 168,
    "target_outlier_range": {
      "min": 3222.1,
      "max": 4667.3
    },
